# 画像の元データ（WSL から見たパス）
SOURCE_DIR=/mnt/c/Users/n049395/OneDrive - nid.co.jp/Microsoft Copilot Chat ファイル

# GitHub Pages で公開される media/ の URL。
# TikTok 開発者ポータルで「URL プレフィックス」として検証した文字列と完全一致させること。
PAGES_BASE_URL=https://ryota-sotoguchi.github.io/tiktok/media

# 1日の投稿本数
POSTS_PER_DAY=5
JPEG_QUALITY=90
KEEP_PUBLISHED_POSTS=20

# TikTok for Developers のアプリ資格情報
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 初回だけ authorize コマンドで取得。以降は state/tokens.json が自動更新される
TIKTOK_REFRESH_TOKEN=
