# ---- 受け渡し（旧: 会社 OneDrive 経由。統合してリポジトリ内で完結）----
# 生成側の書き出し先と投稿側の読み込み元は同じフォルダを指す。
PHONE_EXPORT_DIR=delivery/phone
SOURCE_DIR=delivery/phone
PHONE_EXPORT_AUTO=true

# ---- 生成 ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 1 slot あたりの生成本数。daemon の 4 slot と掛けて 1日16本 = MBTI 16タイプ
# ぶんになり、ネタが日をまたがずに完走する。
SLOT_POSTS=4
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
DEFAULT_HASHTAGS=#MBTI #mbti診断 #16personalities

# エディトリアル motif が使う写真。空にすると motif ごとローテーションから外れる。
MBTI_EDITORIAL_PHOTOS_DIR=assets/editorial_people

# ---- 投稿 ----
# GitHub Pages で公開される media/ の URL。
# TikTok 開発者ポータルで「URL プレフィックス」として検証した文字列と完全一致させること。
PAGES_BASE_URL=https://ryota-sotoguchi.github.io/tiktok/media
POSTS_PER_DAY=10
JPEG_QUALITY=90
KEEP_PUBLISHED_POSTS=20

# ---- TikTok for Developers ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 初回だけ authorize コマンドで取得。以降は state/tokens.json が自動更新される
TIKTOK_REFRESH_TOKEN=
