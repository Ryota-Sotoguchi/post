# ---- 受け渡し（旧: 会社 OneDrive 経由。統合してリポジトリ内で完結）----
# 生成側の書き出し先と投稿側の読み込み元は同じフォルダを指す。
PHONE_EXPORT_DIR=delivery/phone
SOURCE_DIR=delivery/phone
PHONE_EXPORT_AUTO=true

# ---- 生成 ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 1日の生成本数は投稿側と共通の POSTS_PER_DAY（下）。4 slot に均等に割る。
# 以下2つは旧形式（run-daily / 旧 run-slot）用で、定期実行では使わない。
SLOT_POSTS=4
DAILY_POSTS=16
# ネタ生成の深さ。deep だと踏み込んだ切り口を要求する。
TOPIC_DEPTH=deep
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
DEFAULT_HASHTAGS=#MBTI #mbti診断 #16personalities

# エディトリアル motif が使う写真。空にすると motif ごとローテーションから外れる。
MBTI_EDITORIAL_PHOTOS_DIR=assets/editorial_people

# ---- 投稿 ----
# GitHub Pages で公開される media/ の URL。
# TikTok 開発者ポータルで「URL プレフィックス」として検証した文字列と完全一致させること。
PAGES_BASE_URL=https://ryota-sotoguchi.github.io/post/media
# 1日の生成本数と送信上限。生成側もこれを読むので、在庫が切れも積み上がりもしない。
POSTS_PER_DAY=10
JPEG_QUALITY=90
KEEP_PUBLISHED_POSTS=20
# 描き直した在庫（穴埋め）を何本ぶん docs/media に上げておくか。
# 223本すべてを上げるとJPEGが250MB増えて、その大半は一度も使われない。
PUBLISH_FILLER=30
# out/ と delivery/phone/ の画像を残す日数。テーマの全投稿を送り終えてからこの日数で削除（台本は残す）。
KEEP_LOCAL_DAYS=60

# ---- TikTok for Developers ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 初回だけ authorize コマンドで取得。以降は state/tokens.json が自動更新される
TIKTOK_REFRESH_TOKEN=
